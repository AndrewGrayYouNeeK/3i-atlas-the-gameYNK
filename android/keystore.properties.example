# Copy to android/keystore.properties (gitignored) for local signed release builds.
# Or rely on env vars used by CI: ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD,
# ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD.

storeFile=/absolute/path/to/atlas3i-upload.jks
storePassword=replace-me
keyAlias=atlas3i
keyPassword=replace-me
