{
  "name": "PlayerProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Player's email"
    },
    "display_name": {
      "type": "string",
      "description": "Display name on leaderboard"
    },
    "total_score": {
      "type": "number",
      "default": 0
    },
    "best_score": {
      "type": "number",
      "default": 0
    },
    "missions_completed": {
      "type": "number",
      "default": 0
    },
    "perfect_stealth_count": {
      "type": "number",
      "default": 0
    },
    "selected_skin": {
      "type": "string",
      "default": "default"
    },
    "owned_skins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "default"
      ]
    },
    "gas_charges": {
      "type": "object",
      "properties": {
        "methane": {
          "type": "number",
          "default": 3
        },
        "ammonia": {
          "type": "number",
          "default": 3
        },
        "xenon": {
          "type": "number",
          "default": 3
        }
      },
      "default": {
        "methane": 3,
        "ammonia": 3,
        "xenon": 3
      }
    },
    "owned_powerups": {
      "type": "object",
      "properties": {
        "gravity_shield": {
          "type": "number",
          "default": 0
        },
        "probe_scrambler": {
          "type": "number",
          "default": 0
        },
        "stealth_cloak": {
          "type": "number",
          "default": 0
        }
      },
      "default": {
        "gravity_shield": 0,
        "probe_scrambler": 0,
        "stealth_cloak": 0
      }
    }
  },
  "required": [
    "user_email"
  ]
}