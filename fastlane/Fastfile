# frozen_string_literal: true

default_platform(:ios)

BUNDLE_ID = "com.youneek.atlas3i"
IPA_PATH = "build/ios/3I-ATLAS.ipa"

platform :ios do
  def asc_secrets_present?
    !ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.empty? &&
      !ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.empty? &&
      !ENV["APP_STORE_CONNECT_API_KEY_P8"].to_s.empty? &&
      !ENV["APPLE_TEAM_ID"].to_s.empty?
  end

  def load_asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8").gsub("\\n", "\n"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
  end

  def write_auth_key_file!
    path = File.expand_path("build/AuthKey.p8")
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, ENV.fetch("APP_STORE_CONNECT_API_KEY_P8").gsub("\\n", "\n"))
    path
  end

  def distribution_p12_present?
    !ENV["IOS_DISTRIBUTION_CERTIFICATE_P12"].to_s.empty?
  end

  def import_distribution_certificate!
    require "base64"

    p12_path = File.expand_path("build/ios_distribution.p12")
    FileUtils.mkdir_p(File.dirname(p12_path))
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_P12")))

    keychain_name = ENV["MATCH_KEYCHAIN_NAME"] || "login.keychain-db"
    keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"] || ""

    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"].to_s,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )
  end

  def xcode_authentication_xcargs(auth_key_path)
    [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{auth_key_path}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}"
    ].join(" ")
  end

  desc "Build a signed App Store IPA (ASC API key + automatic or p12 signing)"
  lane :build do
    UI.user_error!("ASC API key / APPLE_TEAM_ID secrets are required for signed builds") unless asc_secrets_present?

    setup_ci if ENV["CI"]

    api_key = load_asc_api_key
    team_id = ENV.fetch("APPLE_TEAM_ID")
    auth_key_path = write_auth_key_file!
    auth_xcargs = xcode_authentication_xcargs(auth_key_path)

    if distribution_p12_present?
      UI.message("Importing IOS_DISTRIBUTION_CERTIFICATE_P12 for durable CI signing")
      import_distribution_certificate!

      get_provisioning_profile(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        force: true
      )
      profile_name = lane_context[SharedValues::SIGH_NAME]

      build_app(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build/ios",
        output_name: "3I-ATLAS.ipa",
        clean: true,
        skip_package_dependencies_resolution: false,
        xcargs: [
          "DEVELOPMENT_TEAM=#{team_id}",
          "CODE_SIGN_STYLE=Manual",
          "CODE_SIGN_IDENTITY='Apple Distribution'",
          "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
          auth_xcargs
        ].join(" "),
        export_options: {
          method: "app-store",
          teamID: team_id,
          signingStyle: "manual",
          provisioningProfiles: {
            BUNDLE_ID => profile_name
          }
        },
        export_xcargs: auth_xcargs
      )
    else
      UI.important(
        "IOS_DISTRIBUTION_CERTIFICATE_P12 not set — using Xcode automatic signing with " \
        "the ASC authentication key. Prefer a durable .p12 on GitHub-hosted runners " \
        "(see RELEASE.md)."
      )

      build_app(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build/ios",
        output_name: "3I-ATLAS.ipa",
        clean: true,
        skip_package_dependencies_resolution: false,
        xcargs: [
          "DEVELOPMENT_TEAM=#{team_id}",
          "CODE_SIGN_STYLE=Automatic",
          auth_xcargs
        ].join(" "),
        export_options: {
          method: "app-store",
          teamID: team_id,
          signingStyle: "automatic"
        },
        export_xcargs: auth_xcargs
      )
    end
  end

  desc "Build and upload to TestFlight when ASC API key env vars are set"
  lane :beta do
    unless asc_secrets_present?
      UI.important("ASC API key / Apple Team secrets missing — skipping TestFlight upload.")
      next
    end

    api_key = load_asc_api_key

    build

    pilot(
      api_key: api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      app_identifier: BUNDLE_ID
    )
  end
end
