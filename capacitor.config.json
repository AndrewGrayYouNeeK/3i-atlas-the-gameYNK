{
  "appId": "com.youneek.atlas3i",
  "appName": "3I/ATLAS",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "backgroundColor": "#01010c",
    "scheme": "App"
  },
  "android": {
    "backgroundColor": "#01010c",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#01010c",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#01010c",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "none"
    }
  }
}
